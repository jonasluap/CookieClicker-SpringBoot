meta {
  name: Create Upgrade
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/upgrades
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Mini-four de démo",
    "description": "Un bonus par clic et une production passive.",
    "price": 2,
    "clickBonus": 2,
    "passiveBonus": 1
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("upgradeId", res.getBody().id);
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
