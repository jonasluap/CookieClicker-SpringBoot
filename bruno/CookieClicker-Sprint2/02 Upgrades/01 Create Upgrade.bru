meta {
  name: Create Upgrade
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/upgrades
  body: json
  auth: bearer
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test Cursor",
    "description": "Two cookies for each extra click",
    "price": 2,
    "clickBonus": 2,
    "passiveBonus": 0
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("upgradeId", res.body.id);
  }
}
