meta {
  name: Collect Passive Cookies
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/players/{{playerId}}/collect
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Adds one tick of weather-powered passive production", function() {
    expect(res.getStatus()).to.equal(200);
    const bonus = Number(bru.getVar("weatherBonus"));
    expect(res.getBody().cookies).to.equal(1 + 2 * bonus);
    expect(res.getBody().cookiesPerSecond).to.equal(bonus);
  });
}
