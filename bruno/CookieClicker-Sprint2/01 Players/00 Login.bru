meta {
  name: Login
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "cookiePlayerDemo",
    "password": "cookie-player-demo-password"
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.status).to.equal(200);
  });
}

script:post-response {
  // Share the player ID and JWT with later requests in this collection.
  if (res.status === 200) {
    bru.setVar("playerId", res.body.playerId);
    bru.setVar("accessToken", res.body.accessToken);
  }
}
