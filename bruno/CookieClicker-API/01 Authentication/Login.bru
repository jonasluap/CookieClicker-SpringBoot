meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{playerUsername}}",
    "password": "{{playerPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const account = res.getBody();
    bru.setVar("accessToken", account.accessToken);
    bru.setVar("playerId", account.playerId);
    bru.setVar("playerUsername", account.username);
  }
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string").and.not.be.empty;
    expect(res.getBody().playerId).to.be.a("number");
  });
}
