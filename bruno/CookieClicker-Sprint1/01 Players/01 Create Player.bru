meta {
  name: Create Player
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/players
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "cookiePlayerDemo"
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("playerId", res.body.id);
  }
}
