meta {
  name: Purchase History
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/players/{{playerId}}/purchases
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Returns the purchase and the amount paid", function() {
    expect(res.getStatus()).to.equal(200);
    const purchases = res.getBody();
    expect(purchases).to.have.lengthOf(1);
    expect(purchases[0].upgradeId).to.equal(Number(bru.getVar("upgradeId")));
    expect(purchases[0].pricePaid).to.equal(2);
  });
}
