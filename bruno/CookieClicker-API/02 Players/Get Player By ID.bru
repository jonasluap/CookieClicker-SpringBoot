meta {
  name: Get Player By ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/players/{{playerId}}
  body: none
  auth: inherit
}

tests {
  test("HTTP 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(Number(bru.getVar("playerId")));
  });
}
