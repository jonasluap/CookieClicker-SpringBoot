meta {
  name: Create Player
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "cookiePlayerDemo",
    "password": "cookie-player-demo-password"
  }
}

tests {
  test("HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  // A successful signup also signs the player in for later requests in this collection.
  if (res.status === 201) {
    bru.setVar("playerId", res.body.playerId);
    bru.setVar("accessToken", res.body.accessToken);
  }
}
